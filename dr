}

.logo-icon {
    @apply w-6 h-6 text-lime-700 text-2xl leading-6 font-medium
}

.badge-green {
    @apply text-xs text-green-800 px-1.5 py-1 rounded-md border border-green-200 bg-green-50 h-fit shadow
}

.badge-yellow {
    @apply text-xs text-yellow-800 px-1.5 py-1 rounded-md border border-yellow-200 bg-yellow-50 h-fit shadow
}

.badge-blue {
    @apply text-xs text-blue-800 px-1.5 py-1 rounded-md border border-blue-200 bg-blue-50 h-fit shadow
}

.applicant-list {
    @apply p-4 flex justify-between items-center transition-all duration-300 ease-in-out hover:bg-blue-50
}

.applicant-list strong {
    @apply text-sm font-medium
}

.applicant-list small {
    @apply text-sm text-gray-600
}

.applicant-head {
    @apply grid px-4 pt-2 pb-4
}

.applicant-head strong {
    @apply text-xl font-medium
}

.applicant-head small {
    @apply text-sm leading-4 text-gray-600
}

.search-input {
    @apply w-full p-2.5 text-sm text-neutral-900 border-y border-l border-neutral-200 rounded-l-lg focus:outline-none focus-visible:ring-2 focus:border-none ring-lime-700 transition-colors duration-300 ease-in-out
}

.btn-search {
    @apply flex items-center justify-center p-2.5 text-neutral-900 border border-neutral-200 hover:border-lime-700 rounded-r-lg hover:bg-emerald-100 hover:text-lime-700 h-fit transition-colors duration-300 ease-in-out
}

.area-input-today {
    @apply w-full resize-none py-2.5 text-sm text-neutral-900 border-b border-neutral-200 focus:outline-none focus:border-teal-900 transition-colors duration-300 ease-in-out
}

.area-input-next {
