<div id="calendarContainer" class="fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-white p-5 rounded-xl shadow-lg w-80 hidden">
    <div class="flex justify-between items-center">
        <h2 id="monthYear" class="text-lg font-semibold"></h2>
        <div class="space-x-2">
            <button id="prevMonth" class="px-2 py-1 bg-gray-200 rounded">&#9665;</button>
            <button id="nextMonth" class="px-2 py-1 bg-gray-200 rounded">&#9655;</button>
        </div>
    </div>
    <div class="grid grid-cols-7 text-center mt-3 text-gray-600">
        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
    </div>
    <div id="calendarGrid" class="grid grid-cols-7 gap-2 text-center mt-2">
        <!-- Dates will be generated by JavaScript -->
    </div>
    <div class="mt-4 space-y-2">
        <button id="tomorrowBtn" class="w-full bg-gray-200 p-2 rounded">Tomorrow</button>
        <button id="nextWeekBtn" class="w-full bg-gray-200 p-2 rounded">Next Week</button>
    </div>
    <div class="mt-4 flex justify-between items-center">
        <span>Time</span>
        <div class="flex items-center space-x-2">
            <input type="text" id="timeInput" value="12:00" class="w-14 text-center border rounded p-1">
            <button id="toggleAmPm" class="px-2 py-1 bg-gray-200 rounded">AM</button>
        </div>
    </div>
  </div>